{
  "manifest_version": 3,
  "name": "Spotifast Lab Companion",
  "version": "0.1.0",
  "description": "Pair a Spotify web-player tab with the native Spotifast Lab interface. Experimental ad filtering.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://spclient.wg.spotify.com/*",
    "https://ads.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect this Spotify tab to Spotifast Lab"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "spotify_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
